{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.levik.ai"
        }
      ],
      "destination": "https://levik.ai/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.levik.ai"
        }
      ],
      "destination": "https://levik.ai/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "levikai.com"
        }
      ],
      "destination": "https://levik.ai/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "levikai.com"
        }
      ],
      "destination": "https://levik.ai/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.levikai.com"
        }
      ],
      "destination": "https://levik.ai/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.levikai.com"
        }
      ],
      "destination": "https://levik.ai/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
